# Copy outside the repository, fill paths/origins, and chmod 0600.
# Both referenced files must be regular mode-0600 files.
FILMFORGE_TUNNEL_CONFIG_FILE=/etc/filmforge/secrets/cloudflared-gpu0.yml
FILMFORGE_TUNNEL_CREDENTIAL_FILE=/etc/filmforge/secrets/cloudflared-gpu0.json
FILMFORGE_TUNNEL_LOCAL_URL=http://127.0.0.1:9000
FILMFORGE_TUNNEL_PUBLIC_URL=https://gpu0.example.invalid
FILMFORGE_TUNNEL_UNIT=filmforge-worker-tunnel-gpu0.service
