#!/usr/bin/env bash
set -euo pipefail

# A stable named Cloudflare tunnel is intentionally used here. Quick tunnels
# (trycloudflare URLs) change identity across restarts and therefore cannot be a
# backend routing contract.
: "${FILMFORGE_TUNNEL_LOCAL_URL:?FILMFORGE_TUNNEL_LOCAL_URL is required}"
: "${FILMFORGE_TUNNEL_PUBLIC_URL:?FILMFORGE_TUNNEL_PUBLIC_URL is required}"
: "${FILMFORGE_TUNNEL_CONFIG_FILE:?FILMFORGE_TUNNEL_CONFIG_FILE is required}"
: "${FILMFORGE_TUNNEL_CREDENTIAL_FILE:?FILMFORGE_TUNNEL_CREDENTIAL_FILE is required}"
: "${FILMFORGE_TUNNEL_WORKER_SECRET_FILE:?FILMFORGE_TUNNEL_WORKER_SECRET_FILE is required}"
: "${FILMFORGE_TUNNEL_CUTOVER_AUTHORIZATION_FILE:?FILMFORGE_TUNNEL_CUTOVER_AUTHORIZATION_FILE is required}"
: "${FILMFORGE_TUNNEL_WORKER_CODE_RELEASE_ID:?FILMFORGE_TUNNEL_WORKER_CODE_RELEASE_ID is required}"
: "${CLOUDFLARED_BIN:?CLOUDFLARED_BIN is required}"

case "$FILMFORGE_TUNNEL_LOCAL_URL" in
  http://127.0.0.1:*) ;;
  *) echo "tunnel local URL must target exact IPv4 loopback" >&2; exit 1 ;;
esac
case "$FILMFORGE_TUNNEL_PUBLIC_URL" in
  https://*) ;;
  *) echo "tunnel public URL must use HTTPS" >&2; exit 1 ;;
esac

for protected_file in \
  "$FILMFORGE_TUNNEL_CONFIG_FILE" \
  "$FILMFORGE_TUNNEL_CREDENTIAL_FILE" \
  "$FILMFORGE_TUNNEL_WORKER_SECRET_FILE"; do
  test -f "$protected_file" && test ! -L "$protected_file" || {
    echo "tunnel protected file is missing or not regular" >&2
    exit 1
  }
  test "$(stat -c '%a' "$protected_file")" = "600" || {
    echo "tunnel protected file must have mode 0600" >&2
    exit 1
  }
done

python3 - \
  "$FILMFORGE_TUNNEL_CONFIG_FILE" \
  "$FILMFORGE_TUNNEL_PUBLIC_URL" \
  "$FILMFORGE_TUNNEL_LOCAL_URL" \
  "$FILMFORGE_TUNNEL_CREDENTIAL_FILE" <<'PY'
from pathlib import Path
from urllib.parse import urlsplit
import sys

config_path, public_url, local_url, credential_path = sys.argv[1:]
host = urlsplit(public_url).hostname
source = Path(config_path).read_text()
lines = {
    line.strip()
    for line in source.splitlines()
    if line.strip() and not line.lstrip().startswith("#")
}
ingress = []
current = None
in_ingress = False
for raw_line in source.splitlines():
    stripped = raw_line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    indent = len(raw_line) - len(raw_line.lstrip())
    if stripped == "ingress:":
        in_ingress = True
        continue
    if not in_ingress:
        continue
    if indent == 0:
        break
    if stripped.startswith("- "):
        if current is not None:
            ingress.append(current)
        current = {}
        stripped = stripped[2:].strip()
    if current is not None and ":" in stripped:
        key, _, value = stripped.partition(":")
        current[key.strip()] = value.strip()
if current is not None:
    ingress.append(current)
if (
    f"credentials-file: {credential_path}" not in lines
    or ingress
    != [
        {"hostname": host, "service": local_url},
        {"service": "http_status:404"},
    ]
):
    raise SystemExit("tunnel config does not match the staged public/local/credential contract")
PY

test -x "$CLOUDFLARED_BIN" || {
  echo "cloudflared executable is unavailable" >&2
  exit 1
}
command -v curl >/dev/null 2>&1 || {
  echo "curl is required for the authenticated tunnel watchdog" >&2
  exit 1
}

# Build a protected curl config so the worker bearer never appears in a process
# argument. The watchdog continuously exercises the public edge -> named
# tunnel -> loopback worker route. Three consecutive failures terminate this
# unit; the worker's BindsTo relationship then stops backend heartbeats instead
# of leaving a false-green "online" worker.
WATCHDOG_CONFIG="$(mktemp "${TMPDIR:-/tmp}/filmforge-tunnel-watchdog.XXXXXX")"
chmod 0600 "$WATCHDOG_CONFIG"
python3 - \
  "$FILMFORGE_TUNNEL_WORKER_SECRET_FILE" \
  "$FILMFORGE_TUNNEL_PUBLIC_URL" \
  "$WATCHDOG_CONFIG" <<'PY'
from pathlib import Path
import os
import sys

secret_path, public_url, config_path = sys.argv[1:]
values = {}
for raw_line in Path(secret_path).read_text().splitlines():
    line = raw_line.strip()
    if not line or line.startswith("#"):
        continue
    key, separator, value = line.partition("=")
    if not separator or key in values:
        raise SystemExit("worker secret env is invalid for tunnel watchdog")
    values[key] = value
token = values.get("GPU_WORKER_API_TOKEN") or values.get("WORKER_API_TOKEN")
if not token or any(character.isspace() for character in token) or any(
    character in token for character in ('"', "'", "\\")
):
    raise SystemExit("worker bearer is missing or unsafe for tunnel watchdog")
path = Path(config_path)
path.write_text(
    f'url = "{public_url.rstrip("/")}/health"\n'
    f'header = "Authorization: Bearer {token}"\n'
    'silent\n'
    'show-error\n'
    'max-time = 10\n'
    'max-redirs = 0\n'
    'max-filesize = 65536\n'
)
os.chmod(path, 0o600)
PY
WATCHDOG_BODY="$(mktemp "${TMPDIR:-/tmp}/filmforge-tunnel-health.XXXXXX")"
chmod 0600 "$WATCHDOG_BODY"

TUNNEL_PID=""
cleanup() {
  rm -f "$WATCHDOG_CONFIG" "$WATCHDOG_BODY"
}
terminate() {
  if test -n "$TUNNEL_PID" && kill -0 "$TUNNEL_PID" 2>/dev/null; then
    kill "$TUNNEL_PID" 2>/dev/null || true
    wait "$TUNNEL_PID" 2>/dev/null || true
  fi
  exit 0
}
trap cleanup EXIT
trap terminate INT TERM

"$CLOUDFLARED_BIN" \
  --no-autoupdate \
  --config "$FILMFORGE_TUNNEL_CONFIG_FILE" \
  tunnel run &
TUNNEL_PID="$!"

sleep 15
WATCHDOG_FAILURES=0
while kill -0 "$TUNNEL_PID" 2>/dev/null; do
  if test ! -f "$FILMFORGE_TUNNEL_CUTOVER_AUTHORIZATION_FILE"; then
    sleep 15
    continue
  fi
  test ! -L "$FILMFORGE_TUNNEL_CUTOVER_AUTHORIZATION_FILE" && \
    test "$(stat -c '%a' "$FILMFORGE_TUNNEL_CUTOVER_AUTHORIZATION_FILE")" = "600" || {
      echo "tunnel cutover authorization is unsafe" >&2
      kill "$TUNNEL_PID" 2>/dev/null || true
      wait "$TUNNEL_PID" 2>/dev/null || true
      exit 1
    }
  WATCHDOG_STATUS="$(
    curl --config "$WATCHDOG_CONFIG" \
      --output "$WATCHDOG_BODY" \
      --write-out '%{http_code}' 2>/dev/null || true
  )"
  if test "$WATCHDOG_STATUS" = "200" && python3 - \
    "$WATCHDOG_BODY" \
    "$FILMFORGE_TUNNEL_PUBLIC_URL" \
    "$FILMFORGE_TUNNEL_WORKER_CODE_RELEASE_ID" <<'PY'
import json
import pathlib
import sys

body_path, expected_public_url, expected_code_release_id = sys.argv[1:]
body = pathlib.Path(body_path).read_bytes()
if not body or len(body) > 65536:
    raise SystemExit("worker health response size is invalid")
try:
    value = json.loads(body)
except (UnicodeDecodeError, json.JSONDecodeError):
    raise SystemExit("worker health response is not JSON") from None
if (
    not isinstance(value, dict)
    or value.get("ok") is not True
    or value.get("worker_ok") is not True
    or str(value.get("public_url") or "").rstrip("/")
    != expected_public_url.rstrip("/")
    or value.get("code_release_id") != expected_code_release_id
):
    raise SystemExit("worker health identity does not match secure profile")
PY
  then
    WATCHDOG_FAILURES=0
  else
    WATCHDOG_FAILURES=$((WATCHDOG_FAILURES + 1))
    if test "$WATCHDOG_FAILURES" -ge 3; then
      echo "authenticated public tunnel route failed three consecutive checks" >&2
      kill "$TUNNEL_PID" 2>/dev/null || true
      wait "$TUNNEL_PID" 2>/dev/null || true
      exit 1
    fi
  fi
  sleep 15
done
wait "$TUNNEL_PID"
